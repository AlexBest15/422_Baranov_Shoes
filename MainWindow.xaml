<Window x:Class="_422_Baranov_Shoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обувной магазин" 
        Height="800" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Content="Назад" Click="Back_Click" 
                        Margin="0,0,20,0" Padding="10,5"/>
                <TextBlock x:Name="DateTimeNow" Foreground="White" 
                           VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        <!-- Подвал -->
        <Border Grid.Row="2" Background="#FF2D2D30" Padding="10">
            <TextBlock Foreground="White" Text="© Обувной магазин" 
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>