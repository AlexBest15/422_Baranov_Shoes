<Page x:Class="_422_Baranov_Shoes.Pages.AddProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление товара">

    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF2196F3" CornerRadius="5" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Добавление нового товара" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="400" Margin="0,0,0,20">

                <GroupBox Header="Основная информация" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Название товара:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtProductName" Height="25" Margin="0,0,0,10"/>

                        <TextBlock Text="Артикул:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtArticleNumber" Height="25" Margin="0,0,0,10"/>

                        <TextBlock Text="Описание:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtDescription" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Цена и скидка" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Цена:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtPrice" Height="25" Margin="0,0,0,10"/>

                        <TextBlock Text="Скидка (%):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtDiscount" Height="25" Text="0" Margin="0,0,0,10"/>

                        <TextBlock Text="Количество на складе:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtStockQuantity" Height="25" Text="0" Margin="0,0,0,10"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Справочная информация" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Производитель:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbManufacturer" Height="25" DisplayMemberPath="ManufacturerName" Margin="0,0,0,10"/>

                        <TextBlock Text="Категория:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCategory" Height="25" DisplayMemberPath="CategoryName" Margin="0,0,0,10"/>

                        <TextBlock Text="Поставщик:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbSupplier" Height="25" DisplayMemberPath="SupplierName" Margin="0,0,0,10"/>

                        <TextBlock Text="Единица измерения:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbUnit" Height="25" DisplayMemberPath="UnitName" Margin="0,0,0,10"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Изображение" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Имя файла изображения:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtImageFileName" Height="25" Margin="0,0,0,10"/>
                        <TextBlock Text="(например: 1.jpg или shoe.png)" FontSize="11" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBlock Text="Файл должен находиться в папке Images" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FFF5F5F5" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnSave" 
                        Content="Сохранить" 
                        Width="120" 
                        Height="35" 
                        Margin="5"
                        Background="#FF4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="btnSave_Click"/>

                <Button x:Name="btnCancel" 
                        Content="Отмена" 
                        Width="120" 
                        Height="35" 
                        Margin="5"
                        Background="#FF9E9E9E"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="btnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>