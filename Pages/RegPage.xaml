<Page x:Class="_422_Baranov_Shoes.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница регистрации">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="61*" />
            <ColumnDefinition Width="739*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>

        <Label Grid.Column="1"
               Content="Введите логин"
               HorizontalAlignment="Left"
               Margin="91,30,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="128" />

        <Label Grid.Column="1"
               Content="Введите пароль"
               HorizontalAlignment="Left"
               Margin="91,80,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="128" />

        <Label Grid.Column="1"
               Content="Повторите пароль"
               HorizontalAlignment="Left"
               Margin="91,130,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="128" />

        <Label Grid.Column="1"
               Content="Введите ФИО"
               HorizontalAlignment="Left"
               Margin="91,180,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="128" />

        <TextBox x:Name="txtbxLogin"
                 VerticalContentAlignment="Center"
                 Background="Transparent"
                 ToolTip="Введите логин"
                 Grid.Column="1"
                 HorizontalAlignment="Left"
                 Margin="250,30,0,0"
                 Grid.Row="1"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="250"
                 Height="35"
                 FontSize="14"
                 TextChanged="txtbxLogin_TextChanged" />

        <PasswordBox x:Name="passBxPassword"
                     Background="Transparent"
                     ToolTip="Введите пароль"
                     Grid.Column="1"
                     HorizontalAlignment="Left"
                     Margin="250,80,0,0"
                     Grid.Row="1"
                     VerticalAlignment="Top"
                     Width="250"
                     Height="35"
                     FontSize="14"
                     PasswordChanged="passBxPassword_PasswordChanged" />

        <PasswordBox x:Name="passBxConfirmPassword"
                     Background="Transparent"
                     ToolTip="Повторите пароль"
                     Grid.Column="1"
                     HorizontalAlignment="Left"
                     Margin="250,130,0,0"
                     Grid.Row="1"
                     VerticalAlignment="Top"
                     Width="250"
                     Height="35"
                     FontSize="14"
                     PasswordChanged="passBxConfirmPassword_PasswordChanged" />

        <TextBox x:Name="txtbxFullName"
                 VerticalContentAlignment="Center"
                 Background="Transparent"
                 ToolTip="Введите ФИО"
                 Grid.Column="1"
                 HorizontalAlignment="Left"
                 Margin="250,180,0,0"
                 Grid.Row="1"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="250"
                 Height="35"
                 FontSize="14"
                 TextChanged="txtbxFullName_TextChanged" />

        <Label x:Name="lblLoginHint"
               MouseLeftButtonUp="lblLoginHint_MouseLeftButtonUp"
               Foreground="Gray"
               Grid.Column="1"
               Content="Введите логин"
               HorizontalAlignment="Left"
               Margin="250,30,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="250"
               Height="35"
               VerticalContentAlignment="Center"
               FontSize="14" />

        <Label x:Name="lblPasswordHint"
               MouseLeftButtonUp="lblPasswordHint_MouseLeftButtonUp"
               Foreground="Gray"
               Grid.Column="1"
               Content="Введите пароль"
               HorizontalAlignment="Left"
               Margin="250,80,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="250"
               Height="35"
               VerticalContentAlignment="Center"
               FontSize="14" />

        <Label x:Name="lblConfirmPasswordHint"
               MouseLeftButtonUp="lblConfirmPasswordHint_MouseLeftButtonUp"
               Foreground="Gray"
               Grid.Column="1"
               Content="Повторите пароль"
               HorizontalAlignment="Left"
               Margin="250,130,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="250"
               Height="35"
               VerticalContentAlignment="Center"
               FontSize="14" />

        <Label x:Name="lblFullNameHint"
               MouseLeftButtonUp="lblFullNameHint_MouseLeftButtonUp"
               Foreground="Gray"
               Grid.Column="1"
               Content="Введите ФИО"
               HorizontalAlignment="Left"
               Margin="250,180,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="250"
               Height="35"
               VerticalContentAlignment="Center"
               FontSize="14" />

        <Button x:Name="btnRegister"
                Grid.Column="1"
                Content="Зарегистрироваться"
                HorizontalAlignment="Left"
                Margin="250,240,0,0"
                Grid.Row="1"
                VerticalAlignment="Top"
                Width="180"
                Height="40"
                Background="#FF4CAF50"
                Foreground="White"
                FontWeight="Bold"
                Click="btnRegister_Click" />

        <Button x:Name="btnBack"
                Grid.Column="1"
                Content="Назад"
                HorizontalAlignment="Left"
                Margin="250,290,0,0"
                Grid.Row="1"
                VerticalAlignment="Top"
                Width="180"
                Height="40"
                Background="#FF9E9E9E"
                Foreground="White"
                FontWeight="Bold"
                Click="btnBack_Click" />

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#FFEEEEEE">
            <TextBlock Text="Регистрация нового пользователя" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       FontStyle="Italic"/>
        </Border>
    </Grid>
</Page>