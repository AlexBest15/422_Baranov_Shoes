<Page x:Class="_422_Baranov_Shoes.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="61*" />
            <ColumnDefinition Width="739*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>

        <Label Grid.Column="1"
               Content="Введите логин"
               HorizontalAlignment="Left"
               Margin="91,50,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="128" />

        <Label Grid.Column="1"
               Content="Новый пароль"
               HorizontalAlignment="Left"
               Margin="91,100,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="128" />

        <Label Grid.Column="1"
               Content="Повторите пароль"
               HorizontalAlignment="Left"
               Margin="91,150,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="128" />

        <TextBox x:Name="txtbxLogin"
                 VerticalContentAlignment="Center"
                 Background="Transparent"
                 ToolTip="Введите логин"
                 Grid.Column="1"
                 HorizontalAlignment="Left"
                 Margin="250,50,0,0"
                 Grid.Row="1"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="250"
                 Height="35"
                 FontSize="14" />

        <PasswordBox x:Name="passBxNewPassword"
                     Background="Transparent"
                     ToolTip="Введите новый пароль"
                     Grid.Column="1"
                     HorizontalAlignment="Left"
                     Margin="250,100,0,0"
                     Grid.Row="1"
                     VerticalAlignment="Top"
                     Width="250"
                     Height="35"
                     FontSize="14" />

        <PasswordBox x:Name="passBxConfirmPassword"
                     Background="Transparent"
                     ToolTip="Повторите пароль"
                     Grid.Column="1"
                     HorizontalAlignment="Left"
                     Margin="250,150,0,0"
                     Grid.Row="1"
                     VerticalAlignment="Top"
                     Width="250"
                     Height="35"
                     FontSize="14" />

        <Label x:Name="lblLoginHint"
               MouseLeftButtonUp="lblLoginHint_MouseLeftButtonUp"
               Foreground="Gray"
               Grid.Column="1"
               Content="Введите логин"
               HorizontalAlignment="Left"
               Margin="250,50,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="250"
               Height="35"
               VerticalContentAlignment="Center"
               FontSize="14" />

        <Label x:Name="lblNewPasswordHint"
               MouseLeftButtonUp="lblNewPasswordHint_MouseLeftButtonUp"
               Foreground="Gray"
               Grid.Column="1"
               Content="Введите новый пароль"
               HorizontalAlignment="Left"
               Margin="250,100,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="250"
               Height="35"
               VerticalContentAlignment="Center"
               FontSize="14" />

        <Label x:Name="lblConfirmPasswordHint"
               MouseLeftButtonUp="lblConfirmPasswordHint_MouseLeftButtonUp"
               Foreground="Gray"
               Grid.Column="1"
               Content="Повторите пароль"
               HorizontalAlignment="Left"
               Margin="250,150,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="250"
               Height="35"
               VerticalContentAlignment="Center"
               FontSize="14" />

        <Button x:Name="btnResetPassword"
                Grid.Column="1"
                Content="Сменить пароль"
                HorizontalAlignment="Left"
                Margin="250,210,0,0"
                Grid.Row="1"
                VerticalAlignment="Top"
                Width="180"
                Height="40"
                Background="#FF4CAF50"
                Foreground="White"
                FontWeight="Bold"
                Click="btnResetPassword_Click" />

        <Button x:Name="btnBack"
                Grid.Column="1"
                Content="Назад"
                HorizontalAlignment="Left"
                Margin="250,260,0,0"
                Grid.Row="1"
                VerticalAlignment="Top"
                Width="180"
                Height="40"
                Background="#FF9E9E9E"
                Foreground="White"
                FontWeight="Bold"
                Click="btnBack_Click" />

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#FFEEEEEE">
            <TextBlock Text="Смена пароля" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       FontStyle="Italic"/>
        </Border>
    </Grid>
</Page>