<Page x:Class="_422_Baranov_Shoes.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">

    <Grid Background="#FFF0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="20">
            <TextBlock Text="Вход в систему" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Основная форма -->
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Width="400"
                    Margin="20">

            <!-- Логин -->
            <Border BorderBrush="#FFCCCCCC" 
                    BorderThickness="1" 
                    Background="White"
                    CornerRadius="3"
                    Margin="0,0,0,15">
                <Grid>
                    <TextBlock x:Name="lblLoginHint"
                               Text="Логин" 
                               Foreground="#FF999999"
                               FontSize="14"
                               Margin="10,8"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <TextBox x:Name="txtbxLogin"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="14"
                             Padding="10,8"
                             TextChanged="txtbxLogin_TextChanged"/>
                </Grid>
            </Border>

            <!-- Пароль -->
            <Border BorderBrush="#FFCCCCCC" 
                    BorderThickness="1" 
                    Background="White"
                    CornerRadius="3"
                    Margin="0,0,0,20">
                <Grid>
                    <TextBlock x:Name="lblPasswordHint"
                               Text="Пароль" 
                               Foreground="#FF999999"
                               FontSize="14"
                               Margin="10,8"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <PasswordBox x:Name="passBxPassword"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Padding="10,8"
                                 PasswordChanged="passBxPassword_PasswordChanged"/>
                </Grid>
            </Border>

            <!-- Кнопки -->
            <Button x:Name="btnLogin"
                    Content="Войти"
                    Background="#FF0078D7"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    Padding="15,10"
                    Margin="0,0,0,10"
                    Click="btnLogin_Click"
                    Cursor="Hand"/>

            <Button x:Name="btnGuest"
                    Content="Войти как гость"
                    Background="#FFE6E6E6"
                    Foreground="#FF333333"
                    FontSize="14"
                    Padding="15,10"
                    Margin="0,0,0,10"
                    Click="btnGuest_Click"
                    Cursor="Hand"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                <Button x:Name="btnRegister"
                        Content="Регистрация"
                        Background="Transparent"
                        Foreground="#FF0078D7"
                        FontSize="12"
                        BorderThickness="0"
                        Padding="10,5"
                        Click="btnRegister_Click"
                        Cursor="Hand"/>

                <Rectangle Width="1" 
                           Height="12" 
                           Fill="#FFCCCCCC" 
                           Margin="5,0"/>

                <Button x:Name="btnForgotPassword"
                        Content="Забыли пароль?"
                        Background="Transparent"
                        Foreground="#FF0078D7"
                        FontSize="12"
                        BorderThickness="0"
                        Padding="10,5"
                        Click="btnForgotPassword_Click"
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>

        <!-- Подвал -->
        <Border Grid.Row="2" 
                Background="#FFF5F5F5" 
                BorderBrush="#FFE0E0E0" 
                BorderThickness="0,1,0,0"
                Padding="20">
            <TextBlock Text="Для работы требуется подключение к базе данных" 
                       Foreground="#FF666666"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Page>