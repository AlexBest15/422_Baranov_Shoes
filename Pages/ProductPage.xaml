<Page x:Class="_422_Baranov_Shoes.Pages.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Товары">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF2196F3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Каталог обуви" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="White"
                           Margin="0,0,10,0"/>
                <TextBlock x:Name="txtUserRole"
                           FontSize="16"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ListView x:Name="ItemsProducts" 
                      Background="White"
                      BorderThickness="0"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10"
                                Height="200"
                                Background="{Binding BackgroundColor}">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#FF2196F3"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,3"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Background="#FFF5F5F5"
                                        Width="160"
                                        Height="160"
                                        BorderBrush="#FFDDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                    <Image Source="{Binding ImagePath}" 
                                           Stretch="Uniform"
                                           MaxHeight="150"
                                           MaxWidth="150"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Column="1" 
                                        Background="{Binding InfoBackground}"
                                        BorderBrush="#FFEEEEEE"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="10,0,10,0"
                                        Padding="10"
                                        VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CategoryName}" 
                                                   FontSize="12"
                                                   Foreground="{Binding TextForeground}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,2"/>

                                        <TextBlock Text="{Binding ProductName}" 
                                                   FontWeight="Bold" 
                                                   FontSize="16"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="45"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding TextForeground}"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Text="{Binding ShortDescription}" 
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="50"
                                                   Foreground="{Binding TextForeground}"
                                                   Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="Производитель:"
                                                       FontSize="11"
                                                       Foreground="{Binding LabelForeground}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding ManufacturerName}"
                                                       FontSize="11"
                                                       Foreground="{Binding TextForeground}"
                                                       FontWeight="SemiBold"
                                                       Margin="5,0,20,0"/>

                                            <TextBlock Grid.Row="0" Grid.Column="2"
                                                       Text="Поставщик:"
                                                       FontSize="11"
                                                       Foreground="{Binding LabelForeground}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3"
                                                       Text="{Binding SupplierName}"
                                                       FontSize="11"
                                                       Foreground="{Binding TextForeground}"
                                                       FontWeight="SemiBold"
                                                       Margin="5,0,0,0"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="Цена:"
                                                       FontSize="11"
                                                       Foreground="{Binding LabelForeground}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding PriceText}"
                                                       FontSize="12"
                                                       Foreground="#FF2196F3"
                                                       FontWeight="Bold"
                                                       Margin="5,0,20,0"/>

                                            <TextBlock Grid.Row="1" Grid.Column="2"
                                                       Text="Ед. изм.:"
                                                       FontSize="11"
                                                       Foreground="{Binding LabelForeground}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="3"
                                                       Text="{Binding UnitName}"
                                                       FontSize="11"
                                                       Foreground="{Binding TextForeground}"
                                                       FontWeight="SemiBold"
                                                       Margin="5,0,0,0"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="На складе:"
                                                       FontSize="11"
                                                       Foreground="{Binding LabelForeground}"
                                                       Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding StockStatusText}"
                                                       FontSize="11"
                                                       Foreground="{Binding StockStatusColor}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" 
                                        Background="{Binding DiscountBackground}"
                                        BorderBrush="#FFDDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Center"
                                        Height="140">
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="Скидка" 
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding TextForeground}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,10"/>

                                        <Border Background="Red" 
                                                CornerRadius="20"
                                                Padding="12,6"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding DiscountVisibility}">
                                            <TextBlock Text="{Binding DiscountText}" 
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="Нет скидки" 
                                                   FontSize="11"
                                                   Foreground="{Binding TextForeground}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,0"
                                                   Visibility="{Binding NoDiscountVisibility}"/>

                                        <TextBlock Text="{Binding OldPriceText}" 
                                                   FontSize="11"
                                                   Foreground="{Binding TextForeground}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,0"
                                                   TextDecorations="Strikethrough"
                                                   Visibility="{Binding OldPriceVisibility}"/>

                                        <TextBlock Text="{Binding NewPriceText}" 
                                                   FontSize="12"
                                                   Foreground="Red"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding NewPriceVisibility}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" 
                                        Background="{Binding ActionBackground}"
                                        BorderBrush="#FFDDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Height="140">
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="Действия" 
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding TextForeground}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,20"/>

                                        <Button Content="Подробнее" 
                                                Background="#FF2196F3"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                FontSize="11"
                                                Tag="{Binding ProductID}"
                                                Click="btnDetails_Click"
                                                Height="32"
                                                Width="80"
                                                Padding="2"
                                                BorderThickness="0"
                                                BorderBrush="#FFDDDDDD"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}">
                                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FF1976D2"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FFEEEEEE">
            <StackPanel x:Name="pnlControls" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">

                <TextBox x:Name="txtSearch" 
                         Width="200" 
                         Height="30" 
                         Margin="5"
                         Padding="5"
                         TextChanged="txtSearch_TextChanged"
                         ToolTip="Поиск по названию, артикулу, описанию"/>

                <ComboBox x:Name="cmbCategory" 
                          Width="150" 
                          Height="30" 
                          Margin="5"
                          DisplayMemberPath="CategoryName"
                          SelectionChanged="cmbCategory_SelectionChanged"
                          ToolTip="Фильтр по категории"/>

                <ComboBox x:Name="cmbManufacturer" 
                          Width="150" 
                          Height="30" 
                          Margin="5"
                          DisplayMemberPath="ManufacturerName"
                          SelectionChanged="cmbManufacturer_SelectionChanged"
                          ToolTip="Фильтр по производителю"/>

                <ComboBox x:Name="cmbSort" 
                          Width="150" 
                          Height="30" 
                          Margin="5"
                          SelectionChanged="cmbSort_SelectionChanged"
                          ToolTip="Сортировка товаров">
                    <ComboBoxItem Content="По цене (возр.)" Tag="PriceAsc"/>
                    <ComboBoxItem Content="По цене (убыв.)" Tag="PriceDesc"/>
                    <ComboBoxItem Content="По названию" Tag="Name"/>
                    <ComboBoxItem Content="По остаткам" Tag="Stock"/>
                </ComboBox>

                <Button x:Name="btnAddProduct" 
                        Content="Добавить товар" 
                        Width="110"
                        Height="30" 
                        Margin="5"
                        Background="#FF4CAF50"
                        Foreground="White"
                        FontSize="11"
                        Click="btnAddProduct_Click"
                        Visibility="Collapsed"
                        ToolTip="Добавить новый товар"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>